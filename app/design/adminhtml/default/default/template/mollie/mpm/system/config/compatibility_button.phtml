<script type="text/javascript">
    function checkComatibility() {
        const resultEl = document.getElementById('payment_mollie_compatibility_result');

        resultEl.style.display = 'none';

        const params = new URLSearchParams({ form_key: FORM_KEY });

        fetch('<?php echo $this->escapeUrl($this->getAjaxCheckUrl()) ?>?' + params.toString())
            .then(response => response.text())
            .then(text => {
                resultEl.innerHTML = text || 'Unknown error, please check logs';
                resultEl.style.display = '';
            })
            .catch(() => {
                resultEl.innerHTML = 'Request failed, please check logs';
                resultEl.style.display = '';
            });
    }
</script>
<?php echo $this->getButtonHtml() ?>
